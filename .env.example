# Catdex API (api/, Cloud Run) for the SMU BIA AI Lodge demo. Copy to .env; .env is gitignored.
# The web app (web/, Vercel) needs one variable: VITE_API_BASE = this API's URL.

# Trading-card writer: any OpenAI-compatible gateway (vision). Default: the club gateway.
API_BASE_URL=https://api.apiyi.com/v1
# This project's own key from the AI Lodge key bot. Secret: never commit it.
# Without it, cards use the student's built-in template personality (labelled "Template card").
API_KEY=
# The card writer reads the cat photo, so it needs a vision model. AI Lodge default: deepseek-v4-1-flash-260910 (reads images).
# The student's model was Claude Haiku 4.5 (claude-haiku-4-5-20251001).
VISION_MODEL_NAME=deepseek-v4-1-flash-260910

# Frontend origins, comma-separated. vercel-setup.sh writes the real Vercel URL here.
CORS_ORIGINS=http://localhost:5173

# Per IP per window. scan = one hit per scan (the student's YOLO, CLIP and re-ID models on this server);
# card = one hit per AI-written card. The central control sheet overrides these;
# UPSTASH_REDIS_REST_URL/_TOKEN come from the batch's shared env.
RATE_LIMIT_SCAN_MAX=20
RATE_LIMIT_CARD_MAX=5
RATE_LIMIT_WINDOW_SECONDS=432000
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# The original Gradio app (app.py, not deployed) reads ANTHROPIC_API_KEY / ANTHROPIC_BASE_URL instead.
